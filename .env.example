# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# The 'export' prefix makes variables available to child processes (e.g. bash deploy.sh).

export AWS_ACCOUNT_ID=123456789012
export AWS_REGION=us-east-1
export DOMAIN=example.com
export PARSER_EMAIL_USER=parser
export NOTIFY_EMAIL=you@example.com
export ALLOWED_SENDERS=you@example.com
export S3_BUCKET_NAME=my-email-parser-store
export HOSTED_ZONE_ID=Z0123456789EXAMPLE
export CLAUDE_MODEL=claude-sonnet-5-5
export SSM_API_KEY_PATH=/email-parser/claude-api-key
