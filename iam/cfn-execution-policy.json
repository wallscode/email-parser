{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProjectAssets",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cdk-{{QUALIFIER}}-assets-{{ACCOUNT_ID}}-{{REGION}}/email-parser/*"
    },
    {
      "Sid": "UpdateParserFunctionOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:Get*",
        "lambda:List*"
      ],
      "Resource": "arn:aws:lambda:{{REGION}}:{{ACCOUNT_ID}}:function:email-parser"
    },
    {
      "Sid": "ResolveParserRoleArn",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/{{STACK_NAME}}-LambdaRole*"
    },
    {
      "Sid": "KeepParserRoleOnUpdate",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/{{STACK_NAME}}-LambdaRole*",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    }
  ]
}
