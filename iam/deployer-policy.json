{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TestUploadEmail",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::{{BUCKET}}/raw-emails/*"
    },
    {
      "Sid": "TestReadParsedOutput",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::{{BUCKET}}/parsed-output/*"
    },
    {
      "Sid": "TestListParsedOutput",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "parsed-output/*"
          ]
        }
      }
    },
    {
      "Sid": "TestInvokeFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:{{REGION}}:{{ACCOUNT_ID}}:function:email-parser"
    },
    {
      "Sid": "TestReadLogs",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams",
        "logs:StartLiveTail"
      ],
      "Resource": [
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/lambda/email-parser",
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/lambda/email-parser:*"
      ]
    },
    {
      "Sid": "CliSignInWithConsoleCredentials",
      "Effect": "Allow",
      "Action": [
        "signin:AuthorizeOAuth2Access",
        "signin:CreateOAuth2Token"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnPasswordAndMfa",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ChangePassword",
        "iam:ListMFADevices",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice"
      ],
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:user/{{DEPLOYER_USER}}"
    },
    {
      "Sid": "CreateOwnVirtualMfa",
      "Effect": "Allow",
      "Action": "iam:CreateVirtualMFADevice",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:mfa/{{DEPLOYER_USER}}"
    },
    {
      "Sid": "ReadPasswordPolicy",
      "Effect": "Allow",
      "Action": "iam:GetAccountPasswordPolicy",
      "Resource": "*"
    }
  ]
}
